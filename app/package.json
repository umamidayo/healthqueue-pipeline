{
  "name": "healthqueue-api",
  "version": "1.0.0",
  "description": "Stateless triage wait-time estimator used as the reference workload for the delivery pipeline.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-include=src/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml"
  }
}
